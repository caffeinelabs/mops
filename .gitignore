node_modules/
target/
dist/
.dfx/
# icp-cli splits its state: .icp/cache/ is machine-local (managed-network ids,
# downloaded artifacts), while .icp/data/ holds the mainnet/staging id mappings
# and is meant to be committed, so a fresh checkout can deploy without relinking.
.icp/cache/
.mops/
.migrations-*/
# The root lockfile is committed, as our own docs tell every project to do.
# Fixture lockfiles are not: the CLI tests create, rewrite and corrupt them on
# purpose, so committing them would put the suite at war with git on every run.
cli/tests/**/mops.lock
test/**/mops.lock

.DS_Store
